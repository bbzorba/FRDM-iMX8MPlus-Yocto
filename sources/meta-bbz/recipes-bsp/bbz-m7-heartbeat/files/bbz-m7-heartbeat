#!/usr/bin/env python3
# Linux -> M7 heartbeat: write a counter every second into the M7's shared DTCM page
# (A53 address 0x0081F000 = M7 0x2001F000). bbz-m7-boot reports "A53 heartbeat LOST" when it
# stops for 5 s (Linux hung or crashed); the M7 itself keeps running.
import mmap, os, struct, time
fd = os.open("/dev/mem", os.O_RDWR | os.O_SYNC)
page = mmap.mmap(fd, 4096, offset=0x0081F000)
n = 0
while True:
    n = (n + 1) & 0xFFFFFFFF
    page[0:4] = struct.pack("<I", n)
    time.sleep(1)
