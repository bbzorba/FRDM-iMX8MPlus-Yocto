# --- Yocto build output: huge, and fully regenerated by bitbake ---
# Keep only the build configuration (local.conf, bblayers.conf).
/build-wayland/*
!/build-wayland/conf/
/build-wayland/conf/*
!/build-wayland/conf/local.conf
!/build-wayland/conf/bblayers.conf

# Fetched source tarballs (DL_DIR) and a shared-state cache, if moved to the top
/downloads/
/sstate-cache/

# NXP `repo` tool metadata. The layers are tracked as git submodules instead.
/.repo/

# Helper script outputs
/scripts/*.log
/scripts/*.csv
/scripts/.check-build.state

# Editor / office lock and backup files
.~lock.*#
*~

# Application build output (apps/<name>/build/ from a manual `make`)
/apps/**/build/

# Python bytecode
__pycache__/
